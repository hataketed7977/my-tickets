{
  "name": "ticket-center",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "./services/api/gradlew -p services/api bootJar",
    "test": "./services/api/gradlew -p services/api test",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck"
  },
  "engines": {
    "node": ">=22.5.0",
    "npm": ">=10.0.0"
  }
}
